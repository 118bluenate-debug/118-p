# ==============================================================================
# 118 팔배개 (118 PAL-BEGAE) 환경 설정
# 한국인터넷진흥원(KISA) 118 상담센터 로컬 AI 상담지원 시스템
# ==============================================================================

# 서버 기본 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WS_SERVER_URL=ws://127.0.0.1:8000/ws/audio

# 오디오 수집 설정 (Windows Host Line-in)
AUDIO_DEVICE_INDEX=-1              # -1: 기본 입력 장치, 또는 특정 Line-in 장치 번호
AUDIO_TARGET_SAMPLE_RATE=16000     # STT 표준 샘플레이트 (16kHz)
AUDIO_CHANNELS=1                   # Mono PCM
AUDIO_CHUNK_MS=30                  # 프레임 단위 (30ms = 480 samples @ 16kHz)
VAD_ENERGY_THRESHOLD=0.008         # VAD 음성 활동 감지 임계값 (0.001 ~ 0.05)
VAD_SILENCE_TIMEOUT_MS=800         # 무음 지속 시 발화 분할 타임아웃 (ms)
AUDIO_SAVE_PERMANENT=false         # 보안 정책: 원본 오디오 영구 저장 금지(기본값 false)

# STT 엔진 설정
STT_ENGINE=faster-whisper          # faster-whisper | mock
STT_MODEL_SIZE=base                # tiny | base | small | medium | large-v3
STT_DEVICE=cuda                    # cuda | cpu
STT_COMPUTE_TYPE=float16           # float16 | int8_float16 | int8 | float32
STT_LANGUAGE=ko                    # 한국어 우선 (ko)
STT_INTERIM_INTERVAL_MS=350        # 실시간 화면 표시용 중간 전사 주기

# 로컬 LLM 설정 (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b        # exaone3.5:7.8b | qwen3:4b | gemma3:4b
OLLAMA_TIMEOUT_SECONDS=30

# 보안 및 마스킹 설정
MASK_PII_ENABLED=true              # 전화번호, 주민등록번호, 계좌번호 마스킹
SECURITY_DICTIONARY_ENABLED=true   # KISA 118 보안 전문용어 보정 사전 적용

# CRM 연계 설정
CRM_ADAPTER=mock                   # mock | rest_api
CRM_DATA_DIR=c:/118-p/data/crm_records
